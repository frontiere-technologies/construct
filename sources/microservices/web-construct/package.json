{
  "name": "@construct/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev --port 3000",
    "dev:pretty": "next dev --port 3000 2>&1 | pino-pretty --colorize --ignore pid,hostname,service",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "I18N_INTEGRATION_DB=1 vitest run -c vitest.integration.config.ts",
    "test:migrations": "node --test ../../devops/db/migration-lib.test.mjs",
    "test:docs-contract": "node --test ../../devops/docs-contract.test.mjs",
    "test:i18n-keys": "node --test ../../devops/i18n-key-inventory.test.mjs",
    "test:env-contract": "node --test ../../devops/env-contract.test.mjs",
    "test:raw-colors": "node --test ../../devops/raw-color-ratchet.test.mjs",
    "test:tokens": "node --test ../../devops/token-vocabulary.test.mjs",
    "schema:check": "node ../../devops/db/db.mjs schema-check"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@radix-ui/react-slot": "^1.3.3",
    "ag-grid-community": "^36.0.1",
    "ag-grid-react": "^36.0.1",
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "isomorphic-dompurify": "3.21.0",
    "lucide-react": "^1.21.0",
    "next": "16.2.12",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "9.0.3",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.0.0",
    "resend": "^6.14.0",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.1.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "pino-pretty": "^13.1.3",
    "postcss": "8.5.25",
    "tailwindcss": "^4.1.14",
    "typescript": "^6.0.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "nodemailer": "9.0.3",
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  }
}
