# Copia questo file in secret.env e compila i valori reali.
# secret.env è gitignored — non committare mai valori sensibili.
DATABASE_URL=
# MIGRATION_DATABASE_URL belongs to the separate migration Job secret and must
# not be injected into this web runtime secret.
AUTH_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_TENANT_ID=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_KEYCLOAK_ID=
AUTH_KEYCLOAK_SECRET=
AUTH_KEYCLOAK_ISSUER=
RESEND_API_KEY=
EMAIL_DEV_OVERRIDE=

# SMTP — solo se MAIL_PROVIDER=smtp (in ConfigMap)
