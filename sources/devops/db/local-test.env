# The disposable Postgres on this Mac, started by local-test-db.sh (Docker, port 55432).
# Committed on purpose: these credentials open only a throwaway container bound to 127.0.0.1,
# created and destroyed by that script. They are NOT the remote Supabase test database, which
# stays the default (.env.test.local, operator.env, tests/e2e/.env.test).
#
# Opt-in. Export the file in the shell that runs the tests; exported values win over every .env
# file (vitest.integration.config.ts, conftest.py and helpers.operator_env all use set-if-absent):
#   set -a && . sources/devops/db/local-test.env && set +a
#
# Same shape as the database-and-e2e job in .github/workflows/quality.yml, port aside.

# As in CI: an application URL that is never used, so nothing exported from here can fall back on
# the development DATABASE_URL in .env.local, and the "must differ from DATABASE_URL" checks hold.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/application_not_for_tests

# The limited runtime login (member of construct_runtime only), provisioned by local-test-db.sh.
TEST_DATABASE_URL=postgresql://construct_app:construct-app-local-runtime-password@127.0.0.1:55432/construct_test
# No pooler locally: the same login. Must be set, or the remote pooled URL in .env.test.local
# would be picked up by the concurrency integration test.
TEST_DATABASE_POOLED_URL=postgresql://construct_app:construct-app-local-runtime-password@127.0.0.1:55432/construct_test

# The schema owner, as in CI the container's superuser. Read by db.mjs test-apply and the
# test-tenant-* commands, and by withOwner in the integration suite. The web-construct-e2e-local
# configuration in .claude/launch.json unsets it before starting Next.
TEST_MIGRATION_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/construct_test

TEST_DATABASE_DISPOSABLE=1
