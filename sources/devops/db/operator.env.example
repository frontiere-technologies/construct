# Copy outside the web application directory or load explicitly only for
# migration/provisioning commands. Never inject these values into Next.js.
#
# Copy to sources/devops/db/operator.env (gitignored) to have `db.mjs` pick them
# up from one place: `set -a && . ./sources/devops/db/operator.env && set +a`.
MIGRATION_DATABASE_URL=postgresql://operator:password@database-host:5432/postgres
CONSTRUCT_RUNTIME_DB_USER=construct_app
CONSTRUCT_RUNTIME_DB_PASSWORD=

# The disposable test database owns a schema too, so `db.mjs test-apply` needs a
# migration identity of its own. It lives here rather than in .env.test.local for
# one concrete reason: the web-construct-e2e configuration in .claude/launch.json
# bulk-sources that file into a Next process, which would put an owner-level
# connection string in the application's environment — exactly what the first
# line of this file forbids. The suite and the E2E app read TEST_DATABASE_URL and
# TEST_DATABASE_POOLED_URL instead, both of them limited logins.
TEST_MIGRATION_DATABASE_URL=postgresql://operator:password@test-database-host:5432/postgres
# Repeated from .env.test.local so test-apply is satisfied by this file alone.
TEST_DATABASE_DISPOSABLE=1
