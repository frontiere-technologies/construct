# Copy this file to .env.test and fill in your values.
# .env.test is git-ignored and never committed.
TEST_EMAIL=your-admin-test-user@example.com
TEST_EMAIL_USER=your-non-admin-test-user@example.com
TEST_DATABASE_URL=postgresql://dedicated-disposable-test-database
TEST_DATABASE_DISPOSABLE=1
BASE_URL=http://localhost:3000
HEADLESS=true   # Set to false to watch the browser during tests

# Optional. The public page test_embedded.py frames in its positive case; it must
# be a public origin that allows framing, because the embeddability check rejects
# private and loopback targets to prevent SSRF. Defaults to https://example.com/ —
# set it only to swap a target that stopped serving.
# PUBLIC_EMBED_URL=https://example.com/
