# Dependencies
node_modules/
sources/*/*/node_modules/
packages/*/node_modules/
.pnp
.pnp.js

# Build output
dist/
dist-ssr/
build/
sources/*/*/dist/
packages/*/dist/
sources/*/*/.next/
sources/*/*/next-env.d.ts

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
sources/*/*/.env
sources/*/*/.env.local
sources/microservices/web-construct/.env.docker.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS
.DS_Store
.vscode/
.idea/
*.swp
*.swo
Thumbs.db

# TypeScript
*.tsbuildinfo

# Testing
coverage/
.mcp.json
sources/tests/e2e/.env.test

# Python
__pycache__/
*.pyc

# Temporary
tmp/

# Superpowers scratch (session tokens, sdd review diffs) — docs/superpowers/ is tracked separately
.superpowers/

# Credenziali operatore per migrazioni e provisioning dei ruoli. Non devono mai
# finire in un file che un processo Next carica: vedi operator.env.example.
sources/devops/db/operator.env

# Kubernetes secrets (valori reali — mai committare)
sources/devops/k8s/*/secret.env

# Dump di database creati come backup prima delle migrazioni: contengono utenti,
# email, hash delle password e token. Non devono mai entrare nella storia di git.
*.dump
